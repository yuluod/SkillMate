{
  "name": "skillmate",
  "version": "0.0.17",
  "description": "AI Coding Assistant Skill Manager",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24.22.1"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.22.1",
      "onFail": "error"
    }
  },
  "scripts": {
    "tauri": "tauri",
    "frontend:dev": "vite --host --port 1420",
    "frontend:build": "vite build",
    "frontend:test:pure": "node --test src/lib/*.test.mjs",
    "frontend:test:ui": "vitest run",
    "frontend:test": "pnpm frontend:test:pure && pnpm frontend:test:ui",
    "rust:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "rust:sweep": "cargo sweep --time 14 src-tauri",
    "test": "pnpm frontend:test && pnpm rust:test",
    "dev": "tauri dev",
    "build": "tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "30.1.3",
    "vite": "^8.3.4",
    "vitest": "5.0.5"
  }
}
